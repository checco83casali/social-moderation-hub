# Application
APP_NAME="Moderation Hub"
APP_ENV=production
APP_URL=https://yourdomain.com
APP_SECRET=change_this_to_a_random_secret_64chars

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=moderation_hub
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Meta (Facebook) Graph API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Optional: Facebook Login for Business saved configuration id (from Meta dashboard).
# If set, the "Add pages" modal uses it instead of the raw scope list.
META_FB_LOGIN_CONFIG_ID=
# Optional: pin a specific Graph API version (default v19.0).
META_GRAPH_VERSION=v19.0

# OAuth Providers
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

OAUTH_META_CLIENT_ID=your_meta_client_id
OAUTH_META_CLIENT_SECRET=your_meta_client_secret

OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# Session
SESSION_LIFETIME=86400

# License
# Optional URL of a remote license server. Leave empty to disable remote checks.
LICENSE_SERVER_URL=
# Set to "true" to skip remote validation and manage Pro features locally
# via LICENSE_OFFLINE_FEATURES below.
LICENSE_OFFLINE_MODE=false
# Comma-separated list of Pro feature keys to enable when offline.
# Leave empty to keep all features locked (free tier).
LICENSE_OFFLINE_FEATURES=

# Moderation thresholds
# Haiku confidence < this value → escalate to Sonnet
HAIKU_CONFIDENCE_THRESHOLD=0.80
# Sonnet confidence < this value → escalate to human
SONNET_CONFIDENCE_THRESHOLD=0.70

# Recidivism: bans before permanent user ban
RECIDIVISM_COMMENT_BAN_LIMIT=3
