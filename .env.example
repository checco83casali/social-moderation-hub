# Application
APP_NAME="Moderation Hub"
# Public-facing site name (used e.g. on the appeal page). Defaults to APP_NAME.
SITE_NAME="Moderation Hub"
APP_ENV=production
APP_URL=https://yourdomain.com
# Timezone for timestamps/cron (default Europe/Rome).
APP_TIMEZONE=Europe/Rome
# REQUIRED. Random 64-char secret. Signs JWT sessions, appeal tokens and the
# commenter pseudonyms sent to Claude. If empty, appeal/token features fail
# closed. Generate with: php -r "echo bin2hex(random_bytes(32));"
# MUST be unique — do NOT reuse META_WEBHOOK_VERIFY_TOKEN or META_APP_SECRET here.
APP_SECRET=change_this_to_a_random_secret_64chars

# ── Network hardening (optional — see docs/deployment-security.md) ──────────
# The authoritative control is the SERVER FIREWALL. These keys add an
# application-level safety net and enable the "split domain" model.
#
# CSV of internal IPs / CIDR ranges allowed to reach NON-public paths
# (dashboard, /api, OAuth, page-connect). Empty = app-level IP check disabled.
# Example: 10.0.0.0/8,192.168.0.0/16,127.0.0.1
INTERNAL_IP_ALLOWLIST=
# Hostname that may serve ONLY the public endpoints (Meta webhook, appeal page,
# transparency pages). Use this to expose the webhook on a separate subdomain
# that stays open to the internet. Empty = domain split disabled.
# Example: hooks.yourdomain.com
PUBLIC_DOMAIN=
# CSV of trusted reverse-proxy IPs. Only from these will X-Forwarded-For be
# trusted to determine the real client IP. Empty = always use REMOTE_ADDR.
TRUSTED_PROXIES=
# Optional override of the public path prefixes (CSV). Defaults to:
# /webhook/meta,/appeal,/public/,/privacy
PUBLIC_PATHS=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=moderation_hub
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Meta (Facebook) Graph API
META_APP_ID=your_meta_app_id
# From the Meta App dashboard → Settings → Basic. Used as the HMAC key to verify
# the X-Hub-Signature-256 on incoming webhook POSTs. REQUIRED for the webhook.
META_APP_SECRET=your_meta_app_secret
# REQUIRED for the webhook GET handshake. A random value YOU choose; must match
# the "Verify Token" set in the Meta webhook config. Keep it DISTINCT from
# APP_SECRET (this value travels in query strings / Meta dashboard — less secret).
# Generate with: php -r "echo bin2hex(random_bytes(24));"
META_WEBHOOK_VERIFY_TOKEN=change_this_to_a_random_verify_token
# Optional: Facebook Login for Business saved configuration id (from Meta dashboard).
# If set, the "Add pages" modal uses it instead of the raw scope list.
META_FB_LOGIN_CONFIG_ID=
# Optional: pin a specific Graph API version (default v19.0).
META_GRAPH_VERSION=v19.0

# OAuth Providers (configure at least one for moderator login)
# Restrict OAuth login to specific email domains (CSV). STRONGLY recommended in
# production so only your organisation can sign in. Empty = any email allowed.
# Example: rtv.sm,datatrade.sm
OAUTH_ALLOWED_EMAIL_DOMAINS=

OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

OAUTH_META_CLIENT_ID=your_meta_client_id
OAUTH_META_CLIENT_SECRET=your_meta_client_secret

OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
# Microsoft tenant id, or "common" for multi-tenant (only if using Microsoft login).
OAUTH_MICROSOFT_TENANT_ID=common

# Session
SESSION_LIFETIME=86400

# License
# Optional URL of a remote license server. Leave empty to disable remote checks.
LICENSE_SERVER_URL=
# Set to "true" to skip remote validation and manage Pro features locally
# via LICENSE_OFFLINE_FEATURES below.
LICENSE_OFFLINE_MODE=false
# Comma-separated list of Pro feature keys to enable when offline.
# Leave empty to keep all features locked (free tier).
LICENSE_OFFLINE_FEATURES=

# Moderation thresholds
# Haiku confidence < this value → escalate to Sonnet
HAIKU_CONFIDENCE_THRESHOLD=0.80
# Sonnet confidence < this value → escalate to human
SONNET_CONFIDENCE_THRESHOLD=0.70

# Recidivism: bans before permanent user ban
RECIDIVISM_COMMENT_BAN_LIMIT=3
