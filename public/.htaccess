RewriteEngine On

# Aumenta limite query string
LimitRequestLine 16384

# Handle OPTIONS preflight
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Force dashboard through PHP so AccessGuardMiddleware can gate it by IP
RewriteRule ^dashboard\.html$ index.php [L]

# Route everything else to index.php (except existing files/dirs)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]