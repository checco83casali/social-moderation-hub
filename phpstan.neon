includes:
    # Errori preesistenti "congelati" al livello 6 (per lo più: tipi generici degli
    # array non specificati nei service + falsi positivi nelle view che usano
    # extract($vars), + nullability degli stub illuminate). Il NUOVO codice deve
    # passare il livello 6 — la baseline va ridotta a tappe.
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src
        - bin
        - public
    ignoreErrors:
        # Falsi positivi: illuminate/database (standalone, senza Laravel) espone
        # table()/raw()/transaction()/schema() via __callStatic sul Capsule Manager.
        # Non sono metodi statici "reali", quindi PHPStan non li riconosce.
        - '#Call to an undefined static method Illuminate\\Database\\Capsule\\Manager::[a-zA-Z]+\(\)#'
